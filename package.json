{
  "name": "business-starter-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Private, sanitized, modular and scalable SaaS foundation for business applications.",
  "workspaces": [
    "apps/api-node",
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "test": "npm run test:node && npm run test:web && npm run test:worker",
    "test:node": "npm --workspace @business-starter-kit/api-node run test",
    "test:web": "npm --workspace @business-starter-kit/web run test",
    "test:worker": "npm --workspace @business-starter-kit/worker run test",
    "architecture:test": "cd scripts/architecture && node --test",
    "architecture:check": "node scripts/architecture/check.mjs --root .",
    "declarations:test": "cd scripts/declarations && node --test",
    "compose:test": "cd scripts/compose && node --test",
    "infrastructure:test": "cd scripts/quality && node --test",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
