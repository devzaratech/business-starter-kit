bsk-dev.devzaratech.xyz {
        encode gzip

        header {
                X-Frame-Options "DENY"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
                Permissions-Policy "geolocation=(), microphone=(), camera=()"
        }

        handle_path /api/python/* {
                reverse_proxy bsk-dev-api-fastapi:8000 {
                        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
                        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
                        header_up X-Forwarded-Proto {scheme}
                        header_up Host {host}
                }
        }

        handle_path /api/node/* {
                reverse_proxy bsk-dev-api-node:3001 {
                        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
                        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
                        header_up X-Forwarded-Proto {scheme}
                        header_up Host {host}
                }
        }

        handle_path /api/php/* {
                reverse_proxy bsk-dev-api-php:8000 {
                        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
                        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
                        header_up X-Forwarded-Proto {scheme}
                        header_up Host {host}
                }
        }

        handle_path /api/* {
                reverse_proxy bsk-dev-api-spring:8080 {
                        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
                        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
                        header_up X-Forwarded-Proto {scheme}
                        header_up Host {host}
                }
        }

        handle {
                reverse_proxy bsk-dev-web:80 {
                        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
                        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
                        header_up X-Forwarded-Proto {scheme}
                        header_up Host {host}
                }
        }
}

