# Business Starter Kit - LOCAL environment example
# Copy this file to a secure environment-specific secret store or runtime .env file.

BUSINESS_STARTER_ENV=local
PUBLIC_APP_BASE_URL=http://localhost:8080

# Host port convention for LOCAL
# Administrative services are bound to localhost by default. Use VPN/SSH tunnels/Tailscale for remote access.
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6379
SEAWEED_S3_HOST_BIND=127.0.0.1
SEAWEED_S3_HOST_PORT=8333
N8N_HOST_BIND=127.0.0.1
N8N_HOST_PORT=5678
REVERSE_PROXY_HTTP_BIND=0.0.0.0
REVERSE_PROXY_HTTP_PORT=8080
REVERSE_PROXY_HTTPS_BIND=0.0.0.0
REVERSE_PROXY_HTTPS_PORT=8443
POSTGREST_HOST_BIND=127.0.0.1
POSTGREST_HOST_PORT=3000
MONGODB_HOST_BIND=127.0.0.1
MONGODB_HOST_PORT=27017


POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=business_starter_local
POSTGRES_USER=business_starter
POSTGRES_PASSWORD=change-me-local

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://seaweed-s3:8333
S3_REGION=us-east-1
S3_BUCKET=business-starter-local
S3_ACCESS_KEY=change-me-local
S3_SECRET_KEY=change-me-local

N8N_BASE_URL=https://n8n.local.business-starter-kit.test
N8N_HOST=n8n.local.business-starter-kit.test
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-local
N8N_IMAGE=n8nio/n8n:1.121.0

JWT_ISSUER=business-starter-kit-local
JWT_AUDIENCE=business-starter-kit
JWT_SECRET=change-me-with-a-secure-secret

LOG_LEVEL=info
