# Business Starter Kit - LOCAL environment example
# Copy this file to a secure environment-specific secret store or runtime .env file.

BUSINESS_STARTER_ENV=local
PUBLIC_APP_BASE_URL=https://local.business-starter-kit.test

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=business_starter_local
POSTGRES_USER=business_starter
POSTGRES_PASSWORD=change-me-local

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://seaweed-s3:8333
S3_REGION=us-east-1
S3_BUCKET=business-starter-local
S3_ACCESS_KEY=change-me-local
S3_SECRET_KEY=change-me-local

N8N_BASE_URL=https://n8n.local.business-starter-kit.test

JWT_ISSUER=business-starter-kit-local
JWT_AUDIENCE=business-starter-kit
JWT_SECRET=change-me-with-a-secure-secret

LOG_LEVEL=info
