# Business Starter Kit - QA environment example
# Copy this file to a secure environment-specific secret store or runtime .env file.

BUSINESS_STARTER_ENV=qa
PUBLIC_APP_BASE_URL=https://qa.example.com

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=business_starter_qa
POSTGRES_USER=business_starter
POSTGRES_PASSWORD=change-me-qa

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://seaweed-s3:8333
S3_REGION=us-east-1
S3_BUCKET=business-starter-qa
S3_ACCESS_KEY=change-me-qa
S3_SECRET_KEY=change-me-qa

N8N_BASE_URL=https://n8n.qa.example.com
N8N_HOST=n8n.qa.example.com
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-qa

JWT_ISSUER=business-starter-kit-qa
JWT_AUDIENCE=business-starter-kit
JWT_SECRET=change-me-with-a-secure-secret

LOG_LEVEL=info
