# Business Starter Kit - PROD environment example
# Copy this file to a secure environment-specific secret store or runtime .env file.

BUSINESS_STARTER_ENV=prod
PUBLIC_APP_BASE_URL=https://app.example.com

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=business_starter_prod
POSTGRES_USER=business_starter
POSTGRES_PASSWORD=change-me-prod

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://seaweed-s3:8333
S3_REGION=us-east-1
S3_BUCKET=business-starter-prod
S3_ACCESS_KEY=change-me-prod
S3_SECRET_KEY=change-me-prod

N8N_BASE_URL=https://n8n.app.example.com
N8N_HOST=n8n.app.example.com
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-prod

JWT_ISSUER=business-starter-kit-prod
JWT_AUDIENCE=business-starter-kit
JWT_SECRET=change-me-with-a-secure-secret

LOG_LEVEL=info
