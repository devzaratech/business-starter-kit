# Business Starter Kit - DEV environment example
# Copy this file to a secure environment-specific secret store or runtime .env file.

BUSINESS_STARTER_ENV=dev
PUBLIC_APP_BASE_URL=https://dev.example.com

# Host port convention for DEV
# Administrative services are bound to localhost by default. Use VPN/SSH tunnels/Tailscale for remote access.
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=15432
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=16379
SEAWEED_S3_HOST_BIND=127.0.0.1
SEAWEED_S3_HOST_PORT=18333
N8N_HOST_BIND=127.0.0.1
N8N_HOST_PORT=15678
REVERSE_PROXY_HTTP_BIND=0.0.0.0
REVERSE_PROXY_HTTP_PORT=11080
REVERSE_PROXY_HTTPS_BIND=0.0.0.0
REVERSE_PROXY_HTTPS_PORT=11443
POSTGREST_HOST_BIND=127.0.0.1
POSTGREST_HOST_PORT=13000
MONGODB_HOST_BIND=127.0.0.1
MONGODB_HOST_PORT=27018


POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=business_starter_dev
POSTGRES_USER=business_starter
POSTGRES_PASSWORD=change-me-dev

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://seaweed-s3:8333
S3_REGION=us-east-1
S3_BUCKET=business-starter-dev
S3_ACCESS_KEY=change-me-dev
S3_SECRET_KEY=change-me-dev

N8N_BASE_URL=https://n8n.dev.example.com
N8N_HOST=n8n.dev.example.com
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-dev
N8N_IMAGE=n8nio/n8n:1.107.4

JWT_ISSUER=business-starter-kit-dev
JWT_AUDIENCE=business-starter-kit
JWT_SECRET=change-me-with-a-secure-secret

LOG_LEVEL=info
