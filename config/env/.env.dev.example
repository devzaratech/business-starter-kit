# Business Starter Kit - DEV environment example
# Copy this file to a secure environment-specific secret store or runtime .env file.

BUSINESS_STARTER_ENV=dev
PUBLIC_APP_BASE_URL=https://dev.example.com

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=business_starter_dev
POSTGRES_USER=business_starter
POSTGRES_PASSWORD=change-me-dev

REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://seaweed-s3:8333
S3_REGION=us-east-1
S3_BUCKET=business-starter-dev
S3_ACCESS_KEY=change-me-dev
S3_SECRET_KEY=change-me-dev

N8N_BASE_URL=https://n8n.dev.example.com

JWT_ISSUER=business-starter-kit-dev
JWT_AUDIENCE=business-starter-kit
JWT_SECRET=change-me-with-a-secure-secret

LOG_LEVEL=info
