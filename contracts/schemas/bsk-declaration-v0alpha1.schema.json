{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json",
  "title": "BSK offline declaration bundle v0alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "resources", "catalog"],
  "properties": {
    "apiVersion": { "$ref": "#/$defs/apiVersion" },
    "resources": {
      "type": "array",
      "maxItems": 1000,
      "items": { "oneOf": [{ "$ref": "#/$defs/project" }, { "$ref": "#/$defs/environment" }, { "$ref": "#/$defs/service" }] }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policies", "runtimes", "routes"],
      "properties": {
        "policies": { "$ref": "#/$defs/slugSet" },
        "runtimes": { "$ref": "#/$defs/slugSet" },
        "routes": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/route" } }
      }
    }
  },
  "$defs": {
    "apiVersion": { "const": "bsk/v0alpha1" },
    "slug": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$(?![\\s\\S])" },
    "slugSet": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "projectMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "installationRef"],
      "properties": { "name": { "$ref": "#/$defs/slug" }, "installationRef": { "$ref": "#/$defs/slug" } }
    },
    "projectScopedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "installationRef", "projectRef"],
      "properties": {
        "name": { "$ref": "#/$defs/slug" },
        "installationRef": { "$ref": "#/$defs/slug" },
        "projectRef": { "$ref": "#/$defs/slug" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "Project" },
        "metadata": { "$ref": "#/$defs/projectMetadata" },
        "spec": {
          "type": "object", "additionalProperties": false, "required": ["ownerRef"],
          "properties": { "ownerRef": { "$ref": "#/$defs/slug" }, "budgetRef": { "$ref": "#/$defs/slug" } }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "Environment" },
        "metadata": { "$ref": "#/$defs/projectScopedMetadata" },
        "spec": {
          "type": "object", "additionalProperties": false, "required": ["policyRef"],
          "properties": {
            "policyRef": { "$ref": "#/$defs/slug" },
            "quotaRef": { "$ref": "#/$defs/slug" },
            "placementRef": { "$ref": "#/$defs/slug" }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "Service" },
        "metadata": { "$ref": "#/$defs/projectScopedMetadata" },
        "spec": {
          "type": "object", "additionalProperties": false, "required": ["runtimeRef", "port"],
          "properties": {
            "runtimeRef": { "$ref": "#/$defs/slug" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "resources": { "$ref": "#/$defs/serviceResources" },
            "secretRefs": { "$ref": "#/$defs/slugSet" }
          }
        }
      }
    },
    "serviceResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuRequestMillis", "cpuLimitMillis", "memoryRequestBytes", "memoryLimitBytes", "storageBudgetBytes", "pidsLimit", "replicas"],
      "properties": {
        "cpuRequestMillis": { "$ref": "#/$defs/positiveInteger" },
        "cpuLimitMillis": { "$ref": "#/$defs/positiveInteger" },
        "memoryRequestBytes": { "$ref": "#/$defs/positiveInteger" },
        "memoryLimitBytes": { "$ref": "#/$defs/positiveInteger" },
        "storageBudgetBytes": { "$ref": "#/$defs/positiveInteger" },
        "pidsLimit": { "$ref": "#/$defs/positiveInteger" },
        "replicas": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "hostname": {
      "type": "string", "maxLength": 253,
      "pattern": "^(?![0-9]+(?:\\.[0-9]+){3}$(?![\\s\\S]))(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$(?![\\s\\S])"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installationRef", "projectRef", "environmentRef", "serviceRef", "hostname", "pathPrefix", "visibility", "stripPrefix"],
      "properties": {
        "installationRef": { "$ref": "#/$defs/slug" },
        "projectRef": { "$ref": "#/$defs/slug" },
        "environmentRef": { "$ref": "#/$defs/slug" },
        "serviceRef": { "$ref": "#/$defs/slug" },
        "hostname": { "$ref": "#/$defs/hostname" },
        "pathPrefix": { "type": "string", "pattern": "^(?:/|(?:/[A-Za-z0-9_-]+)+)$(?![\\s\\S])" },
        "visibility": { "enum": ["public", "private"] },
        "stripPrefix": { "type": "boolean" }
      }
    }
  }
}
