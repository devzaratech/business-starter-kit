{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://business-starter-kit.dev/schemas/bsk-compose-v0alpha1.schema.json",
  "title": "BSK opt-in Compose request",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "declarations", "target", "workloads"],
  "properties": {
    "apiVersion": { "const": "bsk.compose/v0alpha1" },
    "declarations": { "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json" },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["installationRef", "projectRef", "environmentRef", "hostRef", "deploymentRef"],
      "properties": {
        "installationRef": { "$ref": "#/$defs/slug" }, "projectRef": { "$ref": "#/$defs/slug" },
        "environmentRef": { "$ref": "#/$defs/slug" }, "hostRef": { "$ref": "#/$defs/slug" },
        "deploymentRef": { "$ref": "#/$defs/slug" }
      }
    },
    "workloads": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "role", "image", "resources"],
        "properties": {
          "name": { "$ref": "#/$defs/slug" }, "role": { "enum": ["http", "data", "worker"] },
          "serviceRef": { "$ref": "#/$defs/slug" },
          "image": { "type": "string", "maxLength": 255, "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$(?![\\s\\S])" },
          "resources": { "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/serviceResources" },
          "persistent": { "type": "boolean" },
          "dataRefs": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "$ref": "#/$defs/slug" } }
        },
        "allOf": [
          { "if": { "properties": { "role": { "const": "http" } } }, "then": { "properties": { "serviceRef": {} }, "required": ["serviceRef"] }, "else": { "properties": { "serviceRef": false } } }
        ]
      }
    }
  },
  "$defs": {
    "slug": { "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug" },
    "amount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["cpuMillis", "memoryBytes", "pids", "storageBytes"],
      "properties": { "cpuMillis": { "$ref": "#/$defs/amount" }, "memoryBytes": { "$ref": "#/$defs/amount" }, "pids": { "$ref": "#/$defs/amount" }, "storageBytes": { "$ref": "#/$defs/amount" } }
    },
    "projectBudget": {
      "type": "object", "additionalProperties": false, "required": ["installationRef", "projectRef", "limits"],
      "properties": { "installationRef": { "$ref": "#/$defs/slug" }, "projectRef": { "$ref": "#/$defs/slug" }, "limits": { "$ref": "#/$defs/budget" } }
    },
    "environmentBudget": {
      "type": "object", "additionalProperties": false, "required": ["installationRef", "projectRef", "environmentRef", "limits"],
      "properties": { "installationRef": { "$ref": "#/$defs/slug" }, "projectRef": { "$ref": "#/$defs/slug" }, "environmentRef": { "$ref": "#/$defs/slug" }, "limits": { "$ref": "#/$defs/budget" } }
    },
    "capability": { "enum": ["supported", "unsupported", "unknown"] },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["hostRef", "capacity", "reserved", "capabilities", "storageMode", "projectBudgets", "environmentBudgets"],
      "properties": {
        "hostRef": { "$ref": "#/$defs/slug" }, "capacity": { "$ref": "#/$defs/budget" }, "reserved": { "$ref": "#/$defs/budget" },
        "storageMode": { "enum": ["advisory", "enforce"] },
        "capabilities": {
          "type": "object", "additionalProperties": false, "required": ["cpu", "memory", "pids", "storage"],
          "properties": { "cpu": { "$ref": "#/$defs/capability" }, "memory": { "$ref": "#/$defs/capability" }, "pids": { "$ref": "#/$defs/capability" }, "storage": { "$ref": "#/$defs/capability" } }
        },
        "projectBudgets": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/projectBudget" } },
        "environmentBudgets": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/environmentBudget" } }
      }
    }
  }
}
