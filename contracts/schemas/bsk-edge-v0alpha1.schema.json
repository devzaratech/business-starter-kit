{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://business-starter-kit.dev/schemas/bsk-edge-v0alpha1.schema.json",
  "title": "BSK ES3-A offline route registry input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "installationRef",
    "declarations",
    "hosts",
    "gateways",
    "zones",
    "deployments",
    "routes"
  ],
  "properties": {
    "apiVersion": {
      "const": "bsk.edge/v0alpha1"
    },
    "kind": {
      "const": "RouteRegistryInput"
    },
    "installationRef": {
      "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
    },
    "declarations": {
      "allOf": [
        {
          "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "catalog": {
              "type": "object",
              "properties": {
                "routes": {
                  "type": "array",
                  "maxItems": 0
                }
              }
            }
          }
        }
      ]
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "installationRef"
        ],
        "properties": {
          "name": {
            "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
          },
          "installationRef": {
            "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
          }
        }
      }
    },
    "gateways": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/gateway"
      }
    },
    "zones": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/zone"
      }
    },
    "deployments": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "visibility"
        ],
        "properties": {
          "resource": {
            "$ref": "#/$defs/deployment"
          },
          "visibility": {
            "$ref": "#/$defs/visibility"
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectRef",
        "environmentRef"
      ],
      "properties": {
        "projectRef": {
          "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
        },
        "environmentRef": {
          "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/apiVersion"
        },
        "kind": {
          "const": "EdgeGateway"
        },
        "metadata": {
          "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/projectMetadata"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostRef",
            "driver",
            "listenerPorts"
          ],
          "properties": {
            "hostRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "driver": {
              "enum": [
                "caddy",
                "nginx",
                "traefik"
              ]
            },
            "listenerPorts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  80,
                  443
                ]
              }
            }
          }
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "installationRef",
        "hostname",
        "visibility",
        "owners"
      ],
      "properties": {
        "name": {
          "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
        },
        "installationRef": {
          "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
        },
        "hostname": {
          "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/hostname"
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "owners": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/owner"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/apiVersion"
        },
        "kind": {
          "const": "Deployment"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "installationRef",
            "projectRef",
            "environmentRef"
          ],
          "properties": {
            "name": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "installationRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "projectRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "environmentRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            }
          }
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "serviceRef",
            "hostRef",
            "artifact",
            "serviceGeneration"
          ],
          "properties": {
            "serviceRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "hostRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "artifact": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*@sha256:[a-f0-9]{64}$(?![\\s\\S])"
            },
            "serviceGeneration": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/positiveInteger"
            }
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/apiVersion"
        },
        "kind": {
          "const": "DomainBinding"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "installationRef",
            "projectRef",
            "environmentRef"
          ],
          "properties": {
            "name": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "installationRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "projectRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "environmentRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            }
          }
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gatewayRef",
            "zoneRef",
            "hostname",
            "pathPrefix",
            "serviceRef",
            "deploymentRef",
            "visibility",
            "stripPrefix"
          ],
          "properties": {
            "gatewayRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "zoneRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "hostname": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/hostname"
            },
            "pathPrefix": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/route/properties/pathPrefix"
            },
            "serviceRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "deploymentRef": {
              "$ref": "https://business-starter-kit.dev/schemas/bsk-declaration-v0alpha1.schema.json#/$defs/slug"
            },
            "visibility": {
              "$ref": "#/$defs/visibility"
            },
            "stripPrefix": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
