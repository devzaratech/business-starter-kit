# Project
PROJECT_NAME=business-starter-kit
APP_ENV=vps
PUBLIC_BASE_URL=http://localhost:8080


# Host port bindings for local single-stack usage
# Internal container ports stay stable; host ports may change per environment.
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=60432
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=60379
SEAWEED_S3_HOST_BIND=127.0.0.1
SEAWEED_S3_HOST_PORT=60833
N8N_HOST_BIND=127.0.0.1
N8N_HOST_PORT=60678
REVERSE_PROXY_HTTP_BIND=0.0.0.0
REVERSE_PROXY_HTTP_PORT=8080
REVERSE_PROXY_HTTPS_BIND=0.0.0.0
REVERSE_PROXY_HTTPS_PORT=8443
POSTGREST_HOST_BIND=127.0.0.1
POSTGREST_HOST_PORT=3000
MONGODB_HOST_BIND=127.0.0.1
MONGODB_HOST_PORT=27017

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=business_starter
POSTGRES_USER=business_starter
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# SeaweedFS S3
S3_ENDPOINT=http://seaweed-s3:8333
S3_REGION=us-east-1
S3_BUCKET=business-starter-storage
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_IMAGE=n8nio/n8n:1.121.0

# API
API_PORT=8080
NODE_INTEGRATION_PORT=3001

# Security
JWT_SECRET=change_me_with_a_long_random_value
ENCRYPTION_KEY=change_me_with_32_bytes_minimum

# SeaweedFS local-only admin/API ports
SEAWEED_MASTER_HOST_BIND=127.0.0.1
SEAWEED_MASTER_HOST_PORT=60933
SEAWEED_FILER_HOST_BIND=127.0.0.1
SEAWEED_FILER_HOST_PORT=60888
COMPOSE_PROJECT_NAME=bsk-vps
