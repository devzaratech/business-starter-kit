# Project
PROJECT_NAME=business-starter-kit
APP_ENV=local
PUBLIC_BASE_URL=http://localhost

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=business_starter
POSTGRES_USER=business_starter
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# SeaweedFS S3
S3_ENDPOINT=http://seaweed-s3:8333
S3_REGION=us-east-1
S3_BUCKET=business-starter-storage
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# API
API_PORT=8080
NODE_INTEGRATION_PORT=3001

# Security
JWT_SECRET=change_me_with_a_long_random_value
ENCRYPTION_KEY=change_me_with_32_bytes_minimum
